{
  "name": "vba-necromancer",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "app"
  ],
  "scripts": {
    "test": "vitest run --reporter=verbose",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc -b packages/ovba packages/vba packages/workbook app --noEmit",
    "fixtures:build": "vite-node fixtures/build/build.ts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "cfb": "^1.2.2",
    "eslint": "^9.0.0",
    "fast-check": "^3.22.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
